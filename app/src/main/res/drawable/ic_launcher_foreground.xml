<!-- Launcher glyph: a flying disc with two motion lines, in the app's accent color. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The disc -->
    <path
        android:fillColor="#00E5A0"
        android:pathData="M 26,54 a 28,11 0 1 0 56,0 a 28,11 0 1 0 -56,0 Z" />
    <!-- Motion lines trailing the disc -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00E5A0"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M 14,36 Q 24,32 34,38" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00E5A0"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M 10,50 Q 22,45 34,52" />
</vector>
